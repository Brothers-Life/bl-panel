# ============================================================================
#  bl-panel-api — copier ce fichier en .env et remplir les valeurs
#  (sur Railway / un hébergeur : mettre les mêmes variables dans ses réglages)
# ============================================================================

# --- Base & ingestion (déjà en place) ---------------------------------------
DATABASE_URL=postgres://user:motdepasse@hote:5432/base
INGEST_TOKEN=un-long-jeton-secret-partage-avec-bl_telemetry
FIVEM_BASE=http://ip-du-serveur:30120

# --- Connexion Discord au panel (OBLIGATOIRE pour protéger le panel) ---------
# 1. https://discord.com/developers/applications → New Application
# 2. Onglet OAuth2 : copier Client ID et Client Secret ci-dessous
# 3. OAuth2 → Redirects : ajouter EXACTEMENT la valeur de DISCORD_REDIRECT_URI
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_REDIRECT_URI=https://panel-api.webgune.dev/auth/discord/callback

# Adresse du site du panel (sans / final)
PANEL_URL=https://panel-front.webgune.dev

# Webmasters : ID Discord (clic droit sur ton profil → Copier l'identifiant,
# mode développeur activé). Tous les droits + page « Accès ». Séparés par des virgules.
WEBMASTER_DISCORD_IDS=111111111111111111,222222222222222222

# Secret de signature des sessions (une longue chaîne aléatoire).
# Le changer déconnecte tout le monde.
SESSION_SECRET=change-moi-par-une-longue-chaine-aleatoire

# --- Accès automatique par rôle Discord (facultatif) -------------------------
# Les membres de ce serveur Discord qui ont UN des rôles listés entrent sans
# être ajoutés à la main. Avec un serveur mais sans rôle : tous ses membres.
DISCORD_GUILD_ID=
DISCORD_ALLOWED_ROLE_IDS=

# Durée de la session en jours (défaut 7)
SESSION_DAYS=7

# --- Alertes (facultatif) ----------------------------------------------------
DISCORD_WEBHOOK_URL=
ALERT_ERRORS_5MIN=25
ALERT_MONEY_JUMP=1000000
ALERT_ANTICHEAT_CHANNEL=anticheat
PANEL_TZ=Europe/Paris
