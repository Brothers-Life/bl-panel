# ============================================================================
#  bl-panel-api — copier ce fichier en .env et remplir les valeurs
#  (sur Railway / un hébergeur : mettre les mêmes variables dans ses réglages)
#  La connexion Discord se règle dans le .env du PANEL (bl-panel-front).
# ============================================================================

# --- Base & ingestion ---------------------------------------------------------
DATABASE_URL=postgres://user:motdepasse@hote:5432/base
# Jeton partagé avec le script FiveM bl_telemetry (convar telemetry_token)
INGEST_TOKEN=un-long-jeton-secret
FIVEM_BASE=http://ip-du-serveur:30120

# --- Lien avec le panel ---------------------------------------------------------
# Clé partagée avec le panel (même valeur que PANEL_API_KEY dans son .env).
# Sans elle, l'API est lisible par n'importe qui.
PANEL_API_KEY=une-autre-longue-chaine-aleatoire

# --- Alertes (facultatif) ----------------------------------------------------
DISCORD_WEBHOOK_URL=
ALERT_ERRORS_5MIN=25
ALERT_MONEY_JUMP=1000000
ALERT_ANTICHEAT_CHANNEL=anticheat
PANEL_TZ=Europe/Paris
